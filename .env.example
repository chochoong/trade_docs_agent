# 무역서류 에이전트 환경변수 예시
# 이 파일을 .env로 복사해서 값을 채우세요. .env는 git에 올라가지 않습니다(.gitignore).
#   Windows:     copy .env.example .env
#   macOS/Linux: cp .env.example .env
#
# 지금은 서류 생성·검증(tradedocs.py)이 LLM을 쓰지 않아서 이 파일이 없어도 동작합니다.
# 아래 값은 trade_hub 연동(from-hub)과 LLM 기능(공급처 PI·CI 검토, L/C 문구 대조 등)을 붙일 때 씁니다.
# 변수 이름은 trade_hub(supervisor_llm.py)와 같게 맞췄습니다.

# --- LLM 접속 ----------------------------------------------------------------
# anthropic 또는 openrouter
PROVIDER=anthropic

# PROVIDER=anthropic 일 때
ANTHROPIC_API_KEY=
# 선택: 추론 노력 수준 (low / medium / high 등). 비워 두면 기본값
ANTHROPIC_EFFORT=

# PROVIDER=openrouter 일 때
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# --- trade_hub 공용 DB ----------------------------------------------------------
# 슈퍼바이저가 실행할 때는 자동으로 넘겨줍니다. 직접 실행할 때만 채우세요.
# 예: C:/workspace/trade_hub/data/trade.db
TRADE_DB=
