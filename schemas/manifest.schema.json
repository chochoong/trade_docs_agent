{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trade-docs-agent/manifest.schema.json",
  "title": "Docs manifest (무역서류 에이전트 출력)",
  "description": "output/<deal_id>/manifest.json. 통관·물류 에이전트, 재무 에이전트가 이 파일을 입력으로 읽습니다.",
  "type": "object",
  "required": ["event", "deal_id", "status", "documents", "totals", "validation"],
  "properties": {
    "event": {"const": "docs_generated"},
    "deal_id": {"type": "string"},
    "generated_at": {"type": "string", "format": "date-time"},
    "status": {
      "enum": ["needs_human_review", "approved", "blocked"],
      "description": "needs_human_review: 생성됨, 사람 검토 전 / approved: 사람이 approve로 승인 / blocked: ERROR로 생성 중단. 다른 에이전트는 approved일 때만 사용합니다"
    },
    "our_role": {"enum": ["seller", "buyer"]},
    "partner": {"type": "object"},
    "incoterm": {"type": "object"},
    "payment_terms": {"type": "string"},
    "shipment": {"type": "object", "description": "선적항, 도착항, 선명, ETD/ETA, 운송수단"},
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {"enum": ["PI", "CI", "PL", "SI", "PO"]},
          "number": {"type": "string"},
          "file": {"type": "string", "description": "output/<deal_id>/ 기준 상대경로"},
          "pdf": {"type": "string"},
          "revision": {"type": "integer", "description": "0=최초, 승인 후 내용이 바뀌어 다시 만들면 1, 2 ... (번호에 -R1 등이 붙음)"},
          "sha256": {"type": "string", "description": "xlsx 파일 해시. 받는 쪽은 파일이 바뀌지 않았는지 확인합니다"},
          "content_sha256": {"type": "string", "description": "셀 내용 해시(개정 여부 판단용)"},
          "pdf_sha256": {"type": "string"},
          "unchanged_since_approval": {"type": "boolean"}
        }
      }
    },
    "totals": {
      "type": "object",
      "properties": {
        "currency": {"type": "string"},
        "contract_amount": {"type": "number", "description": "PI/PO 기준 금액"},
        "invoice_amount": {"type": "number", "description": "CI 기준 금액(실제 선적분)"},
        "goods_amount": {"type": "number"},
        "freight": {"type": "number"},
        "insurance": {"type": "number"},
        "cartons": {"type": "integer"},
        "net_weight_kg": {"type": "number"},
        "gross_weight_kg": {"type": "number"},
        "cbm": {"type": "number"}
      }
    },
    "lines": {"type": "array", "description": "품목별 HS코드, 원산지, 수량, 금액, 중량"},
    "validation": {
      "type": "object",
      "properties": {"errors": {"type": "integer"}, "warnings": {"type": "integer"}, "report": {"type": "string"}}
    },
    "human_review": {"type": "array", "items": {"type": "string"}},
    "handoff": {"type": "object", "description": "다음 에이전트별로 필요한 값만 추린 것"},
    "inputs_sha256": {"type": "string", "description": "서류를 만든 deal·기준 데이터의 해시"},
    "approval": {
      "type": "object",
      "properties": {"approved_by": {"type": "string"}, "approved_at": {"type": "string", "format": "date-time"}}
    }
  }
}
